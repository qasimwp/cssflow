<?xml version="1.0"?>
<ruleset name="CSSFlow Phase 14 Quality Audit">
	<description>CSSFlow v1.0 WordPress Coding Standards and PHP 7.4+ compatibility audit.</description>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<file>cssflow</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<!-- WordPress Coding Standards. -->
	<rule ref="WordPress"/>

	<!-- CSSFlow declares PHP 7.4 as its minimum supported PHP version. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
